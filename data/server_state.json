    {
      "id": "rec-7",
      "author_id": "usr-3",
      "title": "Warm Shahi Gulab Jamun in Saffron Syrup",
      "ingredients": [
        "200g soft fresh khoya (mawa)",
        "50g crumbled malai paneer",
        "3 tbsp refined all-purpose flour",
        "Pinch of cooking soda",
        "2 cups organic sugar and 1.5 cups water",
        "10 strands Kashmiri saffron",
        "1/2 tsp freshly ground green cardamom",
        "Pure desi ghee for slow deep frying",
        "Finely slivered pistachios and silver vark for garnish"
      ],
      "instructions": "Gently knead soft mawa and crumbled paneer together on a marble stone until completely smooth with no graininess. Incorporate flour and form smooth, crack-free sphere dumplings. Prepare a one-string warm sugar syrup infused with saffron strands, crushed cardamom, and drops of rose water. Heat pure ghee over medium-low heat. Slowly deep fry the jamuns on low flame, stirring the ghee constantly without touching the balls until they develop a rich, uniform mahogany color. Soak immediately in warm saffron syrup for 2 hours until spongy.",
      "photos": [
        "https://images.unsplash.com/photo-1605197161470-b998242c75aa?auto=format&fit=crop&w=1200&q=80"
      ],
