    {
      "recipe_id": "rec-sandwich-001",
      "id": "rec-sandwich-001",
      "author_uid": "usr-1",
      "author_id": "usr-1",
      "author_name": "Sachin Bhandari (Admin)",
      "title": "Classic Toasted Club Sandwich",
      "description": "Crispy toasted triple-layer sandwich layered with fresh cucumber, ripe tomatoes, spicy green chutney, boiled potatoes, and melted cheese.",
      "prep_time": 15,
      "servings": 2,
      "dietary": [
        "Vegetarian"
      ],
      "meal_type": "Snack",
      "ingredients": [
        "6 slices whole wheat bread",
        "2 tbsp butter",
        "3 tbsp spicy coriander mint chutney",
        "1 large potato boiled and sliced",
        "1 cucumber thinly sliced",
        "1 ripe tomato sliced",
        "1 small red onion sliced",
        "1/2 cup grated processed cheese or mozzarella",
        "1 tsp chaat masala",
        "1/2 tsp black pepper"
      ],
      "instructions": "Butter bread slices generously and spread spicy mint coriander chutney on one side.\nLayer thinly sliced boiled potatoes, crunchy cucumbers, tomatoes, and onions on the bottom slice.\nSprinkle a generous pinch of chaat masala and freshly ground black pepper for that authentic diner punch.\nTop with grated cheese and close with the second buttered bread slice.\nToast on a hot ribbed skillet or grill press with melted butter for 3 minutes on each side until golden brown and super crispy.\nSlice diagonally and serve piping hot with tomato ketchup and mint dip.",
      "image_url": "https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=800&q=80",
      "photos": [
        "https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=800&q=80"
      ],
      "status": "approved",
      "rejection_reason": null,
      "average_rating": 5.0,
